   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "x = np.linspace(0, 2 * np.pi, 100)\n",
    "df = pd.DataFrame({\"x\": x, \"sin\": np.sin(x)})\n",
    "df.plot(x=\"x\", y=\"sin\", title=\"正弦波\")\n",
    "plt.show()"
   ]
  }
